# Base Mainnet deployment configuration.
# Copy this file to .env and fill in every value. The local .env file is ignored by Git.

# Use a dedicated production RPC. The public Base RPC is rate limited.
BASE_RPC_URL=

# Safety guard. Base Mainnet must remain 8453.
BASE_CHAIN_ID=8453

# Dedicated deployment key. Include the 0x prefix.
PRIVATE_KEY=

# Etherscan API key used for BaseScan source verification.
ETHERSCAN_API_KEY=
